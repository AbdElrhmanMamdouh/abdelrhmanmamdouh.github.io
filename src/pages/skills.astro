---
import Base from '../layouts/Base.astro';
import { skillGroups, levelMark, levelLabel, levelRank } from '../data/skills';
import { allProjects, isPublished, projectUrl, shortNames } from '../lib/projects';

const projects = await allProjects();

type Level = 'production' | 'built' | 'evaluated';
// evidence[skill] = [{ project, level }]
const evidence = new Map<string, { id: string; title: string; level: Level; url: string | null }[]>();
for (const p of projects) {
  for (const s of p.data.skills) {
    const list = evidence.get(s.name) ?? [];
    list.push({ id: p.id, title: p.data.title, level: s.level, url: isPublished(p) ? projectUrl(p) : null });
    evidence.set(s.name, list);
  }
}
// Fail the build if a skill in skills.ts has no project behind it (plan 3.1).
for (const g of skillGroups) for (const s of g.skills) {
  if (!evidence.has(s)) throw new Error(`Skill "${s}" has no project evidence. Add it to a project's skills or remove it.`);
}
const best = (s: string): Level =>
  (evidence.get(s) ?? []).reduce<Level>((b, e) => (levelRank[e.level] > levelRank[b] ? e.level : b), 'evaluated');
const matrixSkills = skillGroups.flatMap((g) => g.skills);
---
<Base title="Skills" description="Skills grouped by area, each linked to the projects that prove it, with an honest evidence level.">
  <h1>Skills</h1>
  <p class="lead">Every skill here links to at least one project that shows it. Instead of percentage bars, each one carries an evidence level.</p>

  <dl class="legend">
    {(['production', 'built', 'evaluated'] as const).map((l) => (
      <div><dt aria-hidden="true">{levelMark[l]}</dt><dd>{levelLabel[l]}</dd></div>
    ))}
  </dl>

  {skillGroups.map((g) => (
    <section id={g.id} class="group" aria-labelledby={`${g.id}-h`}>
      <h2 id={`${g.id}-h`}>{g.name}</h2>
      <ul class="skills">
        {g.skills.map((s) => {
          const ev = (evidence.get(s) ?? []).sort((a, b) => levelRank[b.level] - levelRank[a.level]);
          return (
            <li>
              <span class="skill"><span class="mark" title={levelLabel[best(s)]} aria-label={best(s)}>{levelMark[best(s)]}</span> {s}</span>
              <span class="ev">
                {ev.map((e) => (
                  e.url
                    ? <a href={e.url} title={`${e.title} (${e.level})`}>{shortNames[e.id] ?? e.title}</a>
                    : <a href="/projects/" class="pending" title={`${e.title} (${e.level}); case study coming`} data-id={e.id}>{shortNames[e.id] ?? e.title}</a>
                ))}
              </span>
            </li>
          );
        })}
      </ul>
    </section>
  ))}

  <section class="section matrix-sec" aria-labelledby="matrix-h">
    <h2 id="matrix-h">Skills against projects</h2>
    <p class="muted">Generated from each project's front matter. ● production · ◐ built · ○ evaluated.</p>
    <div class="matrix-wrap">
      <table class="matrix">
        <thead>
          <tr>
            <th scope="col">Skill</th>
            {projects.map((p) => <th scope="col"><abbr title={p.data.title}>{(shortNames[p.id] ?? p.id).split(' ')[0]}</abbr></th>)}
          </tr>
        </thead>
        <tbody>
          {matrixSkills.map((s) => (
            <tr>
              <th scope="row">{s}</th>
              {projects.map((p) => {
                const hit = p.data.skills.find((x) => x.name === s);
                return <td aria-label={hit ? `${p.data.title}: ${hit.level}` : undefined}>{hit ? levelMark[hit.level] : ''}</td>;
              })}
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    <ul class="keys muted">
      {projects.map((p) => <li><span class="mono">{(shortNames[p.id] ?? p.id).split(' ')[0]}</span> {p.data.title}</li>)}
    </ul>
  </section>
</Base>
<style>
  .lead { max-width: var(--measure); }
  .legend { display: grid; gap: var(--space-1); margin: var(--space-5) 0 0; font-size: var(--text-sm); }
  .legend div { display: flex; gap: var(--space-3); }
  .legend dt { font-family: var(--font-mono); color: var(--accent); }
  .legend dd { margin: 0; }
  .group h2 { font-size: var(--text-xl); }
  .skills { list-style: none; padding: 0; margin: 0; max-width: 860px; }
  .skills li { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.2fr); gap: var(--space-4); padding: var(--space-2) 0; border-bottom: 1px solid var(--border); }
  @media (max-width: 639px) { .skills li { grid-template-columns: 1fr; gap: var(--space-1); } }
  .mark { font-family: var(--font-mono); color: var(--accent); display: inline-block; width: 1.2em; }
  .ev { display: flex; flex-wrap: wrap; gap: var(--space-1) var(--space-3); font-family: var(--font-mono); font-size: var(--text-xs); align-items: center; }
  .ev .pending { color: var(--muted); text-decoration: none; border-bottom: 1px dotted var(--border-control); }
  .matrix-wrap { overflow-x: auto; }
  .matrix { min-width: 760px; }
  .matrix td { text-align: center; font-family: var(--font-mono); color: var(--accent); }
  .matrix tbody th { font-family: var(--font-sans); text-transform: none; letter-spacing: 0; font-size: var(--text-sm); color: var(--text); font-weight: 400; border-bottom-color: var(--border); white-space: nowrap; }
  .matrix abbr { text-decoration: none; }
  .keys { list-style: none; padding: 0; font-size: var(--text-xs); columns: 2; margin-top: var(--space-4); }
  @media (max-width: 639px) { .matrix-sec { display: none; } }
</style>
