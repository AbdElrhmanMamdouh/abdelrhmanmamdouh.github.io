---
import Base from '../layouts/Base.astro';
import { skillGroups, levelMark, levelLabel, levelRank } from '../data/skills';
import { allProjects, isPublished, projectUrl } from '../lib/projects';

const projects = await allProjects();

type Level = 'production' | 'built' | 'evaluated';
const levelWord = { production: 'Production', built: 'Built', evaluated: 'Evaluated' } as const;
const evidence = new Map<string, { title: string; short: string; level: Level; url: string | null }[]>();
for (const p of projects) {
  for (const s of p.data.skills) {
    const list = evidence.get(s.name) ?? [];
    list.push({ title: p.data.title, short: p.data.short, level: s.level, url: isPublished(p) ? projectUrl(p) : null });
    evidence.set(s.name, list);
  }
}
// Fail the build if a listed skill has no project behind it (plan 3.1).
for (const g of skillGroups) for (const s of g.skills) {
  if (!evidence.has(s)) throw new Error(`Skill "${s}" has no project evidence. Add it to a project's skills or remove it.`);
}
const best = (s: string): Level =>
  (evidence.get(s) ?? []).reduce<Level>((b, e) => (levelRank[e.level] > levelRank[b] ? e.level : b), 'evaluated');
---
<Base title="Skills" description="Skills grouped by area, each linked to the projects that show it and how far I took it.">
  <h1>Skills</h1>
  <p class="lead">Each skill links to the projects where I used it. The mark shows how far I took it.</p>

  <dl class="legend">
    {(['production', 'built', 'evaluated'] as const).map((l) => (
      <div><dt aria-hidden="true">{levelMark[l]}</dt><dd>{levelLabel[l]}</dd></div>
    ))}
  </dl>

  <nav class="jump" aria-label="Skill groups">
    {skillGroups.map((g) => <a href={`#${g.id}`}>{g.name}</a>)}
  </nav>

  {skillGroups.map((g) => (
    <section id={g.id} class="group" aria-labelledby={`${g.id}-h`}>
      <h2 id={`${g.id}-h`}>{g.name}</h2>
      <ul class="skills">
        {g.skills.map((s) => {
          const ev = (evidence.get(s) ?? []).sort((a, b) => levelRank[b.level] - levelRank[a.level]);
          const lv = best(s);
          return (
            <li>
              <span class="skill">
                <span class="mark" aria-hidden="true" title={levelLabel[lv]}>{levelMark[lv]}</span>
                {s}
                <span class="lvl">{levelWord[lv]}</span>
              </span>
              <span class="ev">
                {ev.map((e) => (e.url ? <a href={e.url} title={e.title}>{e.short}</a> : <span>{e.short}</span>))}
              </span>
            </li>
          );
        })}
      </ul>
    </section>
  ))}
</Base>
<style>
  .lead { max-width: var(--measure); }
  .legend { display: grid; gap: var(--space-1); margin: var(--space-5) 0 0; font-size: var(--text-sm); }
  .legend div { display: flex; gap: var(--space-3); }
  .legend dt { font-family: var(--font-mono); color: var(--accent); }
  .legend dd { margin: 0; }
  .jump { display: flex; flex-wrap: wrap; gap: var(--space-2); margin: var(--space-6) 0 0; }
  .jump a { font-size: var(--text-sm); text-decoration: none; border: 1px solid var(--border-control); border-radius: var(--radius-sm); padding: 6px 10px; color: var(--text); }
  .jump a:hover { border-color: var(--accent); color: var(--accent); }
  .group { scroll-margin-top: var(--space-5); }
  .group h2 { font-size: var(--text-xl); }
  .skills { list-style: none; padding: 0; margin: 0; max-width: 860px; }
  .skills li { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.3fr); gap: var(--space-4); padding: var(--space-3) 0; border-bottom: 1px solid var(--border); }
  @media (max-width: 639px) { .skills li { grid-template-columns: 1fr; gap: var(--space-1); } }
  .mark { font-family: var(--font-mono); color: var(--accent); display: inline-block; width: 1.4em; }
  .ev { display: flex; flex-wrap: wrap; gap: var(--space-1) var(--space-4); font-size: var(--text-sm); align-items: center; }
  .ev a { padding: 2px 0; }
  .lvl { font-family: var(--font-mono); font-size: var(--text-xs); color: var(--muted); margin-left: var(--space-2); }
</style>
