---
import Base from '../layouts/Base.astro';
import ProjectCard from '../components/ProjectCard.astro';
import MetricChip from '../components/MetricChip.astro';
import { profile, headlineMetrics, timeline } from '../data/profile';
import { skillGroups } from '../data/skills';
import { allProjects } from '../lib/projects';

const projects = await allProjects();
const featured = projects.filter((p) => p.data.featured).slice(0, 3);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: profile.name,
  alternateName: profile.altName,
  jobTitle: profile.role,
  address: { '@type': 'PostalAddress', addressLocality: 'Alexandria', addressCountry: 'EG' },
  url: Astro.site?.toString(),
  sameAs: [profile.linkedin, profile.github],
  alumniOf: 'Alexandria University',
  subjectOf: {
    '@type': 'ScholarlyArticle',
    name: profile.paper.title,
    sameAs: profile.paper.url,
  },
};
---
<Base jsonLd={jsonLd}>
  <section class="hero" aria-labelledby="hero-h">
    <h1 id="hero-h"><span class="pos">{profile.positioning}</span> <span class="pos-detail">{profile.positioningDetail}</span></h1>
    <div class="actions">
      <a class="btn btn-primary" href={profile.resumePdf} download={profile.resumePdfName}>Download resume (PDF)</a>
      <a class="btn" href="/projects/">See projects</a>
    </div>
  </section>

  <section class="metrics" aria-label="Headline numbers">
    {headlineMetrics.map((m) => <MetricChip value={m.value} label={m.label} size="lg" />)}
  </section>

  <section class="section" aria-labelledby="feat-h">
    <div class="head">
      <h2 id="feat-h">Featured work</h2>
      <a href="/projects/">All projects →</a>
    </div>
    <div class="grid">
      {featured.map((p) => <ProjectCard project={p} />)}
    </div>
  </section>

  <section class="section" aria-labelledby="skills-h">
    <div class="head">
      <h2 id="skills-h">Skills</h2>
      <a href="/skills/">Skills and evidence →</a>
    </div>
    <ul class="groups">
      {skillGroups.map((g) => (
        <li>
          <a href={`/skills/#${g.id}`}>{g.name}</a>
          <span class="muted">{g.skills.slice(0, 4).join(' · ')}</span>
        </li>
      ))}
    </ul>
  </section>

  <section class="section two" aria-labelledby="exp-h">
    <div>
      <h2 id="exp-h">Experience</h2>
      <ol class="tl">
        {timeline.slice(0, 4).map((t) => (
          <li><span class="mono muted">{t.date}</span> <span><strong>{t.title}</strong> · {t.org}</span></li>
        ))}
      </ol>
      <p><a href="/about/">More about me →</a></p>
    </div>
    <div>
      <h2>Contact</h2>
      <p>Open to embedded application and embedded Linux roles. The fastest way to reach me is email or LinkedIn.</p>
      <p><a class="js-email" href="#contact" data-u={profile.emailUser} data-d={profile.emailDomain}>{profile.emailUser} [at] {profile.emailDomain}</a></p>
      <p><a href={profile.linkedin}>LinkedIn</a> · <a href={profile.github}>GitHub</a></p>
    </div>
  </section>
</Base>

<style>
  .hero h1 { font-size: var(--text-2xl); line-height: 1.2; max-width: 30ch; margin-bottom: var(--space-6); }
  @media (min-width: 1024px) { .hero h1 { font-size: var(--text-4xl); line-height: 1.1; max-width: 26ch; } }
  .pos-detail { color: var(--muted); }
  .actions { display: flex; flex-wrap: wrap; gap: var(--space-3); }
  .metrics { display: grid; grid-template-columns: repeat(2, 1fr); gap: var(--space-5); margin-top: var(--space-8); padding: var(--space-5) 0; border-top: 1px solid var(--border); border-bottom: 1px solid var(--border); }
  @media (min-width: 1024px) { .metrics { grid-template-columns: repeat(4, 1fr); } }
  .head { display: flex; align-items: baseline; justify-content: space-between; gap: var(--space-4); margin-bottom: var(--space-5); }
  .head h2 { margin: 0; }
  .groups { list-style: none; padding: 0; margin: 0; display: grid; gap: var(--space-3) var(--space-6); grid-template-columns: 1fr; }
  @media (min-width: 640px) { .groups { grid-template-columns: repeat(2, 1fr); } }
  .groups li { display: flex; flex-direction: column; border-top: 1px solid var(--border); padding-top: var(--space-3); }
  .groups a { font-weight: 600; }
  .groups .muted { font-size: var(--text-sm); }
  .two { display: grid; gap: var(--space-7); }
  @media (min-width: 1024px) { .two { grid-template-columns: 3fr 2fr; } }
  .two h2 { margin-top: 0; }
  .tl { list-style: none; padding: 0; margin: 0 0 var(--space-4); }
  .tl li { display: grid; grid-template-columns: 9.5rem 1fr; gap: var(--space-3); padding: var(--space-2) 0; border-bottom: 1px solid var(--border); font-size: var(--text-sm); }
  @media (max-width: 639px) { .tl li { grid-template-columns: 1fr; gap: 0; } }
</style>
