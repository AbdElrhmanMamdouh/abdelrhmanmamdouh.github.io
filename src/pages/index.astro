---
import Base from '../layouts/Base.astro';
import ProjectCard from '../components/ProjectCard.astro';
import MetricChip from '../components/MetricChip.astro';
import Experience from '../components/Experience.astro';
import { profile, focusAreas } from '../data/profile';
import { skillGroups } from '../data/skills';
import { allProjects } from '../lib/projects';
import { personLd, personId, paperLd } from '../lib/schema';

const projects = await allProjects();
const featured = projects.filter((p) => p.data.featured).slice(0, 4);

const jsonLd = [
  { '@type': 'ProfilePage', '@id': `${Astro.site}#page`, url: Astro.site?.toString(), mainEntity: { '@id': personId(Astro.site) } },
  personLd(Astro.site),
  paperLd(Astro.site),
];
---
<Base jsonLd={jsonLd}>
  <section class="hero" aria-labelledby="hero-h">
    <h1 id="hero-h">{profile.name}</h1>
    <p class="role">{profile.positioning}</p>
    <p class="sub">{profile.positioningDetail}</p>
    <p class="avail mono">{profile.availability}</p>
    <div class="actions">
      <a class="btn btn-primary" href={profile.resumePdf} download={profile.resumePdfName}>Download resume (PDF)</a>
      <a class="btn" href="/projects/">See projects</a>
      <a class="btn js-email-btn" href="#contact" data-u={profile.emailUser} data-d={profile.emailDomain}>Email me</a>
    </div>
  </section>

  <section class="metrics" aria-label="What I work on">
    {focusAreas.map((m) => <MetricChip value={m.value} label={m.label} size="area" />)}
  </section>

  <section class="section" aria-labelledby="feat-h">
    <div class="head">
      <h2 id="feat-h">Featured work</h2>
      <a href="/projects/">All projects →</a>
    </div>
    <div class="grid feat">
      {featured.map((p) => <ProjectCard project={p} />)}
    </div>
  </section>

  <section class="section" aria-labelledby="skills-h">
    <div class="head">
      <h2 id="skills-h">Skills</h2>
      <a href="/skills/">Skills with proof →</a>
    </div>
    <ul class="groups">
      {skillGroups.map((g) => (
        <li>
          <a href={`/skills/#${g.id}`}>{g.name}</a>
          <span class="muted">{g.skills.join(' · ')}</span>
        </li>
      ))}
    </ul>
  </section>

  <section class="section two" aria-labelledby="exp-h">
    <div>
      <h2 id="exp-h">Experience</h2>
      <Experience />
      <p class="more"><a href="/about/">More about me →</a> · <a href="/resume/">Full resume →</a></p>
    </div>
    <div>
      <h2>Get in touch</h2>
      <p>I'm open to embedded application and embedded Linux roles. Email or LinkedIn is the fastest way to reach me.</p>
      <p><a class="js-email" href="#contact" data-u={profile.emailUser} data-d={profile.emailDomain}>{profile.emailUser} [at] {profile.emailDomain}</a></p>
      <p><a href={profile.linkedin}>LinkedIn</a> · <a href={profile.github}>GitHub</a></p>
    </div>
  </section>
</Base>

<style>
  .hero h1 { font-size: var(--text-3xl); margin-bottom: var(--space-2); }
  @media (min-width: 1024px) { .hero h1 { font-size: var(--text-4xl); } }
  .role { font-family: var(--font-serif); font-weight: 600; font-size: var(--text-xl); color: var(--accent); margin-bottom: var(--space-4); }
  .sub { font-size: var(--text-lg); line-height: 1.5; max-width: 60ch; margin-bottom: var(--space-4); }
  .avail { font-size: var(--text-sm); color: var(--muted); margin-bottom: var(--space-6); }
  .actions { display: flex; flex-wrap: wrap; gap: var(--space-3); }
  .metrics { display: grid; grid-template-columns: repeat(2, 1fr); gap: var(--space-5); margin-top: var(--space-8); padding: var(--space-5) 0; border-top: 1px solid var(--border); border-bottom: 1px solid var(--border); }
  @media (min-width: 1024px) { .metrics { grid-template-columns: repeat(4, 1fr); } }
  .head { display: flex; align-items: baseline; justify-content: space-between; flex-wrap: wrap; gap: var(--space-2) var(--space-4); margin-bottom: var(--space-5); }
  .head h2 { margin: 0; }
  .groups { list-style: none; padding: 0; margin: 0; display: grid; gap: var(--space-3) var(--space-6); grid-template-columns: 1fr; }
  @media (min-width: 640px) { .groups { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 1024px) { .groups { grid-template-columns: repeat(3, 1fr); } }
  .groups li { display: flex; flex-direction: column; border-top: 1px solid var(--border); padding-top: var(--space-3); }
  .groups a { font-weight: 600; }
  .groups .muted { font-size: var(--text-sm); }
  .two { display: grid; gap: var(--space-7); }
  @media (min-width: 1024px) { .two { grid-template-columns: 3fr 2fr; } }
  .two h2 { margin-top: 0; }
  .more { margin-top: var(--space-4); }
  @media (min-width: 1024px) { .feat { grid-template-columns: repeat(2, 1fr); } }
</style>
