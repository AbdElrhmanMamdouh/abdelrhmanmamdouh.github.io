---
interface Props { value: string; label: string; size?: 'sm' | 'lg' }
const { value, label, size = 'sm' } = Astro.props;
---
<div class:list={['metric', size]}>
  <span class="value">{value}</span>
  <span class="label">{label}</span>
</div>
<style>
  .metric { display: flex; flex-direction: column; gap: 2px; min-width: 0; }
  .value { font-family: var(--font-mono); font-weight: 500; font-variant-numeric: tabular-nums; color: var(--text); font-size: var(--text-base); line-height: 1.25; }
  .label { font-size: var(--text-xs); color: var(--muted); line-height: 1.35; }
  .lg .value { font-size: var(--text-xl); }
  .lg .label { font-size: var(--text-sm); }
</style>
