---
// Card thumbnail = the project's headline diagram (plan 6.2).
// Client and internal projects show a generic public-technology diagram, not the client's system.
import CardDiagram from './diagrams/CardDiagram.astro';
interface Props { id: string }
const { id } = Astro.props;
---
<div class="thumb"><CardDiagram id={id} /></div>
<style>
  .thumb { aspect-ratio: 16 / 9; display: flex; align-items: center; justify-content: center; padding: var(--space-3) var(--space-4); border-bottom: 1px solid var(--border); background: var(--bg); overflow: hidden; }
</style>
