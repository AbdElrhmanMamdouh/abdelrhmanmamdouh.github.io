---
// Redrawn generic diagrams. Contain no client data.
// One small headline diagram per project, drawn at 400 × 225 so labels stay readable on a card.
// Client and internal projects show the PUBLIC technology (AUTOSAR layering, Xen passthrough,
// an 802.1Q pipeline, a generate–build–test loop), never the client's actual system.
interface Props { id: string; decorative?: boolean }
const { id, decorative = true } = Astro.props;
const m = `cd-${id}`;
const A = `url(#${m}-a)`;
const AH = `url(#${m}-ah)`;

const titles: Record<string, string> = {
  'adas-ecu-ethernet-switch-cdd': 'AUTOSAR Classic layers, with the switch CDD highlighted between the runtime environment and the Ethernet switch',
  'switch-stress-test-framework': 'Test bench: a test PC simulates the switch and talks to the ECU under test, while a diagnostic tester checks the result',
  'switch-frame-pipeline-simulator': 'A frame passing through the stages of an Ethernet switch, with a drop path',
  'android-linux-under-hypervisors': 'A control domain, a Linux driver and cluster domain, and an Android 15 guest on Xen or QNX; UART, USB and camera hardware on the A-sample board are passed through to the guests',
  'bluetooth-wifi-over-ethernet': 'A phone connects by radio to one ECU, which reaches the cluster ECU over Ethernet',
  'ai-test-generation': 'An AI loop that generates tests, builds, runs them and measures coverage, going back to fix failures',
  'sdv-open-platforms': 'Zero-copy publish and subscribe: one shared-memory sample read by several subscribers',
  'qt-instrument-cluster': 'A control panel drives a Qt instrument cluster over TCP',
  'driver-monitoring-tda4vm': 'IR camera to driver state: pre-processing, face detection on the deep-learning accelerator, landmark features and a decision layer',
  'hardware-and-academic': 'Layered firmware: application on top, hardware drivers in the middle, microcontroller drivers at the bottom',
};
const label = titles[id] ?? 'Project diagram';
---
<svg class="dg cd" viewBox="0 0 400 225" role={decorative ? undefined : 'img'} aria-hidden={decorative ? 'true' : undefined} aria-label={decorative ? undefined : label}>
  <defs>
    <marker id={`${m}-a`} viewBox="0 0 10 10" refX="9" refY="5" markerWidth="6" markerHeight="6" orient="auto"><path class="arrowhead" d="M0,0 L10,5 L0,10 z" /></marker>
    <marker id={`${m}-ah`} viewBox="0 0 10 10" refX="9" refY="5" markerWidth="6" markerHeight="6" orient="auto"><path class="arrowhead-hl" d="M0,0 L10,5 L0,10 z" /></marker>
  </defs>

  {id === 'adas-ecu-ethernet-switch-cdd' && (
    <g>
      <rect class="boundary" x="6" y="18" width="300" height="200" rx="4" />
      <text class="boundary-t" x="12" y="12">Microcontroller · AUTOSAR Classic</text>
      <rect class="box" x="20" y="30" width="272" height="34" rx="4" /><text x="156" y="52" text-anchor="middle">Application components</text>
      <rect class="box" x="20" y="72" width="272" height="30" rx="4" /><text x="156" y="92" text-anchor="middle">RTE</text>
      <rect class="box mine" x="20" y="110" width="272" height="40" rx="4" /><text x="156" y="135" text-anchor="middle" class="mine-t">Switch CDD</text>
      <rect class="box" x="20" y="158" width="272" height="30" rx="4" /><text x="156" y="178" text-anchor="middle">Ethernet interface</text>
      <line class="path-hl" x1="292" y1="173" x2="326" y2="173" marker-end={AH} />
      <rect class="box" x="330" y="140" width="64" height="66" rx="4" />
      <text x="362" y="168" text-anchor="middle">Eth.</text><text x="362" y="186" text-anchor="middle">switch</text>
      <rect class="box" x="326" y="30" width="70" height="72" rx="4" />
      <text x="361" y="56" text-anchor="middle" font-size="10.5">Tester</text><text x="361" y="74" text-anchor="middle" font-size="10">UDS, DTCs</text><text x="361" y="92" text-anchor="middle" font-size="10">DLT log</text>
      <line class="line" x1="292" y1="130" x2="326" y2="80" marker-end={A} />
    </g>
  )}

  {id === 'switch-stress-test-framework' && (
    <g>
      <rect class="box mine" x="10" y="30" width="140" height="110" rx="4" />
      <text x="80" y="58" text-anchor="middle" class="mine-t">Test PC</text>
      <text x="80" y="84" text-anchor="middle" font-size="12">simulated</text>
      <text x="80" y="100" text-anchor="middle" font-size="12">switch</text>
      <text x="80" y="124" text-anchor="middle" class="muted-t" font-size="11">scripted replies</text>
      <rect class="box" x="250" y="30" width="140" height="110" rx="4" />
      <text x="320" y="78" text-anchor="middle">ECU under</text><text x="320" y="96" text-anchor="middle">test</text>
      <line class="path-hl" x1="150" y1="66" x2="246" y2="66" marker-end={AH} />
      <line class="line" x1="250" y1="104" x2="154" y2="104" marker-end={A} />
      <text x="200" y="58" text-anchor="middle" font-size="11" class="mine-t">reply · delay</text>
      <text x="200" y="122" text-anchor="middle" font-size="11" class="muted-t">request</text>
      <rect class="box" x="250" y="172" width="140" height="40" rx="4" />
      <text x="320" y="197" text-anchor="middle">Diag. tester</text>
      <line class="line" x1="320" y1="172" x2="320" y2="144" marker-end={A} />
      <text x="80" y="192" text-anchor="middle" font-size="11" class="muted-t">forces errors and</text>
      <text x="80" y="208" text-anchor="middle" font-size="11" class="muted-t">timeouts on demand</text>
    </g>
  )}

  {id === 'switch-frame-pipeline-simulator' && (
    <g>
      {['VLAN', 'Lookup', 'Filter', 'QoS', 'Egress'].map((s, i) => (
        <g>
          <rect class={i === 2 ? 'box mine' : 'box'} x={12 + i * 77} y="70" width="64" height="44" rx="4" />
          <text x={44 + i * 77} y="97" text-anchor="middle" font-size="12" class={i === 2 ? 'mine-t' : ''}>{s}</text>
          {i < 4 && <line class="line" x1={76 + i * 77} y1="92" x2={88 + i * 77} y2="92" marker-end={A} />}
        </g>
      ))}
      <text x="12" y="50" font-size="12" class="muted-t">frame in →</text>
      <text x="388" y="50" font-size="12" class="muted-t" text-anchor="end">→ port out</text>
      <line class="line" x1="198" y1="114" x2="198" y2="160" stroke-dasharray="4 3" />
      <text x="198" y="182" text-anchor="middle" font-size="13">✕ drop</text>
      <text x="198" y="202" text-anchor="middle" font-size="11" class="muted-t">which rule, and why</text>
    </g>
  )}

  {id === 'android-linux-under-hypervisors' && (
    <g>
      <rect class="box" x="10" y="14" width="100" height="92" rx="4" />
      <text x="60" y="52" text-anchor="middle" font-size="12">Control</text>
      <text x="60" y="68" text-anchor="middle" font-size="12">domain</text>
      <text x="60" y="90" text-anchor="middle" font-size="10.5" class="muted-t">no drivers</text>
      <rect class="box mine" x="122" y="14" width="128" height="92" rx="4" />
      <text x="186" y="44" text-anchor="middle" font-size="12" class="mine-t">Linux</text>
      <text x="186" y="62" text-anchor="middle" font-size="10.5">drivers · Yocto</text>
      <text x="186" y="78" text-anchor="middle" font-size="10.5">Qt cluster</text>
      <rect class="box mine" x="262" y="14" width="128" height="92" rx="4" />
      <text x="326" y="44" text-anchor="middle" font-size="12" class="mine-t">Android 15</text>
      <text x="326" y="62" text-anchor="middle" font-size="10.5">AAOS guest</text>
      <text x="326" y="78" text-anchor="middle" font-size="10.5">Bluetooth · camera</text>
      <rect class="boundary" x="6" y="116" width="388" height="28" rx="4" />
      <text x="16" y="135" class="boundary-t" font-size="12">Xen or QNX Hypervisor</text>
      <rect class="box" x="6" y="160" width="388" height="58" rx="4" />
      <text x="16" y="184" font-size="11.5">A-sample</text>
      <text x="16" y="202" font-size="10.5" class="muted-t">new SoC, BSP</text>
      {[['GPIO', 148, 186], ['UART', 210, 300], ['USB', 272, 326], ['Camera', 334, 352]].map(([h, x, tx]) => (
        <g>
          <rect class="box" x={x as number} y="182" width="54" height="26" rx="3" />
          <text x={(x as number) + 27} y="199" text-anchor="middle" font-size="11">{h}</text>
          <line class="path-hl" x1={(x as number) + 27} y1="182" x2={tx as number} y2="110" marker-end={AH} />
        </g>
      ))}
    </g>
  )}

  {id === 'bluetooth-wifi-over-ethernet' && (
    <g>
      <rect class="box" x="10" y="70" width="70" height="80" rx="8" />
      <text x="45" y="114" text-anchor="middle" font-size="12">Phone</text>
      <path class="line" d="M88 98 q10 12 0 24 M96 92 q16 18 0 36" />
      <rect class="box mine" x="112" y="50" width="132" height="120" rx="4" />
      <text x="178" y="88" text-anchor="middle" class="mine-t">Radio ECU</text>
      <text x="178" y="112" text-anchor="middle" font-size="10.5">Bluetooth, Wi-Fi</text>
      <text x="178" y="130" text-anchor="middle" font-size="10.5">policy manager</text>
      <rect class="box" x="290" y="50" width="100" height="120" rx="4" />
      <text x="340" y="94" text-anchor="middle">Cluster</text>
      <text x="340" y="114" text-anchor="middle" font-size="11" class="muted-t">no radio</text>
      <line class="path-hl" x1="244" y1="96" x2="286" y2="96" marker-end={AH} />
      <line class="path-hl" x1="290" y1="124" x2="242" y2="124" marker-end={AH} />
      <text x="264" y="192" text-anchor="middle" font-size="12" class="boundary-t">Ethernet</text>
      <line class="boundary" x1="264" y1="40" x2="264" y2="178" />
    </g>
  )}

  {id === 'ai-test-generation' && (
    <g>
      {['Generate', 'Build', 'Test', 'Coverage'].map((s, i) => (
        <g>
          <rect class={i === 0 ? 'box mine' : 'box'} x={8 + i * 98} y="78" width="82" height="44" rx="4" />
          <text x={49 + i * 98} y="105" text-anchor="middle" font-size="12" class={i === 0 ? 'mine-t' : ''}>{s}</text>
          {i < 3 && <line class="line" x1={90 + i * 98} y1="100" x2={102 + i * 98} y2="100" marker-end={A} />}
        </g>
      ))}
      <path class="path-hl" d="M147 78 C147 40, 49 40, 49 74" marker-end={AH} />
      <path class="path-hl" d="M343 122 C343 172, 49 172, 49 126" marker-end={AH} />
      <text x="98" y="36" text-anchor="middle" font-size="11" class="mine-t">fix build errors</text>
      <text x="196" y="190" text-anchor="middle" font-size="11" class="mine-t">add tests for gaps</text>
      <text x="200" y="216" text-anchor="middle" font-size="11" class="muted-t">LLM agents · retry limits · checkpoints</text>
    </g>
  )}

  {id === 'sdv-open-platforms' && (
    <g>
      <rect class="box" x="10" y="88" width="90" height="48" rx="4" />
      <text x="55" y="116" text-anchor="middle" font-size="12">Publisher</text>
      <rect class="box mine" x="140" y="72" width="110" height="80" rx="4" />
      <text x="195" y="104" text-anchor="middle" font-size="12" class="mine-t">one sample</text>
      <text x="195" y="122" text-anchor="middle" font-size="11">shared memory</text>
      <line class="line" x1="100" y1="112" x2="136" y2="112" marker-end={A} />
      {['Perception', 'Braking', 'Gateway'].map((s, i) => (
        <g>
          <rect class="box" x="290" y={34 + i * 58} width="100" height="40" rx="4" />
          <text x="340" y={58 + i * 58} text-anchor="middle" font-size="12">{s}</text>
          <line class="path-hl" x1="250" y1="112" x2="286" y2={54 + i * 58} marker-end={AH} />
        </g>
      ))}
      <text x="195" y="190" text-anchor="middle" font-size="11" class="muted-t">no copy per subscriber</text>
    </g>
  )}

  {id === 'qt-instrument-cluster' && (
    <g>
      <rect class="box" x="10" y="60" width="110" height="100" rx="4" />
      <text x="65" y="92" text-anchor="middle" font-size="12">Control</text><text x="65" y="108" text-anchor="middle" font-size="12">panel</text>
      <text x="65" y="136" text-anchor="middle" font-size="11" class="muted-t">pedals · gear</text>
      <line class="path-hl" x1="120" y1="110" x2="166" y2="110" marker-end={AH} />
      <text x="143" y="98" text-anchor="middle" font-size="11" class="mine-t">TCP</text>
      <rect class="box" x="170" y="60" width="220" height="100" rx="4" />
      <circle cx="230" cy="110" r="34" fill="none" stroke="var(--text)" stroke-width="1.5" />
      <line x1="230" y1="110" x2="252" y2="90" stroke="var(--accent)" stroke-width="2" />
      <text x="230" y="134" text-anchor="middle" font-size="11">km/h</text>
      <rect class="box mine" x="284" y="78" width="94" height="64" rx="4" />
      <text x="331" y="106" text-anchor="middle" font-size="12" class="mine-t">Map and</text>
      <text x="331" y="122" text-anchor="middle" font-size="12" class="mine-t">route</text>
      <text x="280" y="186" text-anchor="middle" font-size="11" class="muted-t">Qt 6 · QML · C++</text>
    </g>
  )}

  {id === 'driver-monitoring-tda4vm' && (
    <g>
      <rect class="box" x="8" y="22" width="110" height="46" rx="4" />
      <text x="63" y="42" text-anchor="middle" font-size="12">IR camera</text>
      <text x="63" y="58" text-anchor="middle" font-size="10.5" class="muted-t">CSI-2 · V4L2</text>
      <line class="line" x1="118" y1="45" x2="142" y2="45" marker-end={A} />
      <rect class="box mine" x="146" y="22" width="110" height="46" rx="4" />
      <text x="201" y="42" text-anchor="middle" font-size="12" class="mine-t">Pre-process</text>
      <text x="201" y="58" text-anchor="middle" font-size="10.5">VPAC · C66x</text>
      <line class="line" x1="256" y1="45" x2="280" y2="45" marker-end={A} />
      <rect class="box mine" x="284" y="22" width="108" height="46" rx="4" />
      <text x="338" y="42" text-anchor="middle" font-size="12" class="mine-t">Face detect</text>
      <text x="338" y="58" text-anchor="middle" font-size="10.5">C7x + MMA</text>
      <path class="line" d="M338 68 V92 H63 V112" marker-end={A} />
      <rect class="box" x="8" y="116" width="110" height="46" rx="4" />
      <text x="63" y="136" text-anchor="middle" font-size="12">Landmarks</text>
      <text x="63" y="152" text-anchor="middle" font-size="10.5" class="muted-t">68 points</text>
      <line class="line" x1="118" y1="139" x2="142" y2="139" marker-end={A} />
      <rect class="box mine" x="146" y="116" width="110" height="46" rx="4" />
      <text x="201" y="136" text-anchor="middle" font-size="12" class="mine-t">Features</text>
      <text x="201" y="152" text-anchor="middle" font-size="10">pose, EAR, gaze</text>
      <line class="line" x1="256" y1="139" x2="280" y2="139" marker-end={A} />
      <rect class="box" x="284" y="116" width="108" height="46" rx="4" />
      <text x="338" y="136" text-anchor="middle" font-size="12">Driver state</text>
      <text x="338" y="152" text-anchor="middle" font-size="10.5" class="muted-t">4 classes</text>
      <text x="200" y="196" text-anchor="middle" font-size="11" class="muted-t">GStreamer + TIOVX on TI TDA4VM</text>
    </g>
  )}

  {id === 'hardware-and-academic' && (
    <g>
      {[
        { n: 'App', items: ['Smart-home logic'], hl: true },
        { n: 'HAL', items: ['Keypad', 'LCD', 'Motor'] },
        { n: 'MCAL', items: ['DIO', 'ADC', 'Timer'] },
        { n: 'MCU', items: ['ATmega32'] },
      ].map((l, i) => {
        const w = (330 - 6 * (l.items.length - 1)) / l.items.length;
        return (
          <g>
            <text x="8" y={48 + i * 50} font-size="12" class={l.hl ? 'mine-t' : ''}>{l.n}</text>
            {l.items.map((it, j) => (
              <g>
                <rect class={l.hl ? 'box mine' : 'box'} x={62 + j * (w + 6)} y={24 + i * 50} width={w} height="40" rx="4" />
                <text x={62 + j * (w + 6) + w / 2} y={49 + i * 50} text-anchor="middle" font-size="12" class={l.hl ? 'mine-t' : ''}>{it}</text>
              </g>
            ))}
          </g>
        );
      })}
    </g>
  )}
</svg>
<style>
  .cd { font-size: 13px; width: 100%; height: 100%; }
</style>
