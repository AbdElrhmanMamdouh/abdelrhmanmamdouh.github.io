---
// Redrawn generic diagram. Contains no client data.
// V7.2: vision pipeline, left to right, with the hardware block each stage runs on
// where the record states it (ISP, C66x DSPs). Other stages carry no core label.
const stages = [
  { t: 'IR camera', s: 'IMX219 · CSI-2', core: 'V4L2 capture' },
  { t: 'Pre-process', s: 'debayer · scale', core: 'VPAC · C66x', hl: true },
  { t: 'Face detection', s: 'YOLOv5-ti-lite', core: 'C7x + MMA', hl: true },
  { t: 'Landmarks', s: '68 points', core: '' },
  { t: 'Features', s: 'pose, EAR, gaze', core: 'C66x', hl: true },
  { t: 'Driver state', s: 'decision layer', core: '' },
];
const bw = 150, gap = 22, y = 40, h = 64;
---
<svg class="dg" width={stages.length * (bw + gap) - gap + 2} viewBox={`0 0 ${stages.length * (bw + gap) - gap + 2} 160`} role="img" aria-labelledby="dmsp-t dmsp-d">
  <title id="dmsp-t">Driver monitoring vision pipeline</title>
  <desc id="dmsp-d">IMX219 IR camera captured over MIPI CSI-2 and V4L2; pre-processing on the vision accelerator and a C66x DSP; face detection with YOLOv5-ti-lite on the C7x DSP and matrix-multiply accelerator; 68-point facial landmarks; head pose, eye aspect ratio and gaze features on a C66x DSP; and a decision layer that outputs the driver state.</desc>
  <defs>
    <marker id="dmsp-a" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto"><path class="arrowhead" d="M0,0 L10,5 L0,10 z" /></marker>
  </defs>
  <rect class="boundary" x="1" y="18" width={stages.length * (bw + gap) - gap} height="126" rx="4" />
  <text class="boundary-t" x="10" y="12">GStreamer + TIOVX pipeline on the TDA4VM</text>
  {stages.map((st, i) => {
    const x = 1 + i * (bw + gap);
    return (
      <g>
        <rect class={st.hl ? 'box mine' : 'box'} x={x + 8} y={y} width={bw - 16} height={h} rx="4" />
        <text x={x + bw / 2} y={y + 26} text-anchor="middle" class={st.hl ? 'mine-t' : ''}>{st.t}</text>
        <text x={x + bw / 2} y={y + 44} text-anchor="middle" class="muted-t" font-size="11">{st.s}</text>
        {st.core && <text x={x + bw / 2} y={y + h + 24} text-anchor="middle" font-size="11">[{st.core}]</text>}
        {i < stages.length - 1 && (
          <line class="line" x1={x + bw - 8} y1={y + h / 2} x2={x + bw + gap + 6} y2={y + h / 2} marker-end="url(#dmsp-a)" />
        )}
      </g>
    );
  })}
</svg>
