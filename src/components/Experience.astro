---
import { experience } from '../data/profile';
---
<ol class="exp">
  {experience.map((e) => (
    <li class:list={['job', { current: e.current }]}>
      <div class="job-head">
        <p class="job-title"><strong>{e.title}</strong> · <span class="muted">{e.org}</span></p>
        <span class="date mono">{e.date}</span>
      </div>
      <ul class="items">
        {e.items.map((it) => (
          <li>
            <a href={it.href}>{it.title}</a> <span class="muted">· {it.org}</span>
            <span class="date mono">{it.date}</span>
          </li>
        ))}
      </ul>
    </li>
  ))}
</ol>
<style>
  .exp { list-style: none; padding: 0; margin: 0; max-width: 820px; }
  .job { border-left: 2px solid var(--border-control); padding: 0 0 var(--space-5) var(--space-5); position: relative; }
  .job::before { content: ''; position: absolute; left: -6px; top: 7px; width: 10px; height: 10px; background: var(--bg); border: 1px solid var(--text); }
  .job.current::before { background: var(--accent); border-color: var(--accent); }
  .job:last-child { padding-bottom: 0; }
  .job-head { display: flex; flex-wrap: wrap; justify-content: space-between; gap: var(--space-1) var(--space-4); }
  .job-title { margin: 0; }
  .date { font-size: var(--text-xs); color: var(--muted); white-space: nowrap; }
  .items { list-style: none; padding: 0; margin: var(--space-2) 0 0; }
  .items li { display: flex; flex-wrap: wrap; align-items: baseline; gap: 0 var(--space-2); padding: var(--space-2) 0; border-bottom: 1px solid var(--border); font-size: var(--text-sm); }
  .items .date { margin-left: auto; }
</style>
