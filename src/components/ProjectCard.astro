---
import Tag from './Tag.astro';
import Thumb from './Thumb.astro';
import { isPublished, projectUrl, type Project } from '../lib/projects';
interface Props { project: Project; headingLevel?: 'h2' | 'h3' }
const { project, headingLevel = 'h3' } = Astro.props;
const d = project.data;
const published = isPublished(project);
const H = headingLevel;
const allTags = [...d.areas, ...d.tags];
---
<article class="card" id={project.id} data-tags={JSON.stringify(allTags)}>
  <Thumb id={project.id} />
  <div class="body">
    <p class="eyebrow">{d.context} · {d.period}</p>
    <H class="title">
      {published ? <a href={projectUrl(project)}>{d.title}</a> : d.title}
    </H>
    <p class="hook">{d.hook}</p>
    <div class="tags">{d.tags.slice(0, 5).map((t) => <Tag name={t} />)}</div>
    <p class="more">
      {published && (
        <a href={projectUrl(project)}>Read more<span class="visually-hidden">: {d.title}</span> →</a>
      )}
      {d.repo && <> · <a href={d.repo}>Code →</a></>}
    </p>
  </div>
</article>
<style>
  .card { background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius-md); overflow: hidden; display: flex; flex-direction: column; transition: border-color 150ms; }
  .card:hover { border-color: var(--accent); }
  .body { padding: var(--space-5); display: flex; flex-direction: column; gap: var(--space-3); flex: 1; }
  .eyebrow { margin: 0; }
  .title { font-family: var(--font-serif); font-size: var(--text-lg); line-height: 1.3; margin: 0; }
  .title a { color: var(--text); text-decoration: none; }
  .title a:hover { color: var(--accent); text-decoration: underline; }
  .hook { margin: 0; font-size: var(--text-sm); }
  .metrics { display: grid; grid-template-columns: repeat(auto-fit, minmax(90px, 1fr)); gap: var(--space-3); padding: var(--space-3) 0; border-top: 1px solid var(--border); border-bottom: 1px solid var(--border); }
  .tags { display: flex; flex-wrap: wrap; gap: 6px; }
  .more { margin: auto 0 0; font-size: var(--text-sm); font-weight: 500; display: flex; flex-wrap: wrap; justify-content: space-between; gap: var(--space-2); align-items: baseline; }
  .more a { padding: 4px 0; }
  .conf { font-family: var(--font-mono); font-size: var(--text-xs); color: var(--muted); font-weight: 400; }
</style>
